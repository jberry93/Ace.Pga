<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>10-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>

    <PackageId>Ace.Pga</PackageId>
    <Description>Strongly typed .NET models and validation for the U.S. CBP ACE Partner Government Agency (PGA) Message Set.</Description>
    <Authors>Jeffrey Berry</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jberry93/Ace.Pga</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jberry93/Ace.Pga</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags></PackageTags>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
